{
	"name": "frontend-template",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --mode development",
		"prod": "vite --mode production",
		"build:checksum": "sh ./scripts/build-checksum.sh",
		"build:dev": "npm run build:checksum && tsc && vite build --mode development",
		"build:staging": "npm run build:checksum && tsc && vite build --mode staging",
		"build:prod": "npm run build:checksum && tsc && vite build --minify --mode production",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"preview": "vite preview",
		"lint-staged": "lint-staged"
	},
